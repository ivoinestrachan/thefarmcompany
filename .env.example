# Postgres connection for Prisma. Copy to .env for local dev. In production these
# are provided automatically by the Vercel + Neon integration. Both .env files
# are gitignored.
#
#   DATABASE_URL          = POOLED connection   (Neon: ...-pooler...  used at runtime)
#   DATABASE_URL_UNPOOLED = DIRECT connection   (used by prisma db push / migrations)
#
# Then run:  npx prisma db push     (creates the Signup table)
# View them: npx prisma studio      (opens a table browser)

DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Google Maps Platform key with the "Map Tiles API" enabled — powers the
# Photoreal 3D view (Google Photorealistic 3D Tiles). Client-exposed by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
