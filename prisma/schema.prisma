generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Signup {
  id        String   @id @default(cuid())
  name      String
  email     String
  farm      String
  location  String
  site      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
