# Real soil-probe gateway (optional).
#
# Leave these unset and the app serves data from the built-in generator, so it
# runs out of the box. Set them in .env.local (gitignored) to stream from a
# real probe network instead. The dashboard code and API are identical either
# way — only the data source changes.
#
# SENSOR_API_URL=https://your-gateway.example.com
# SENSOR_API_KEY=replace-with-your-key

# Hero 3D model (optional).
#
# The hero renders a built-in placeholder bug until you supply a model. Drop a
# GLB at public/models/bug.glb and it loads automatically, or point this at any
# GLB/GLTF URL. Must be public (NEXT_PUBLIC_) since it loads in the browser.
#
# NEXT_PUBLIC_BUG_MODEL_URL=/models/bug.glb
