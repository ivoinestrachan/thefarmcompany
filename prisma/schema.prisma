generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Signup {
  id        String   @id @default(cuid())
  name      String
  email     String
  farm      String
  location  String
  site      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/* ------------------------------------------------------------------ */
/*  farmOS — the operator console. A farmer signs in, draws their      */
/*  fields on the map, logs what's growing, and scouts crop health.    */
/*  Every observation is geotagged inside a field so the data becomes  */
/*  the ground-truth map the Wiggler will navigate underground.        */
/* ------------------------------------------------------------------ */

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  createdAt     DateTime     @default(now())
  sessions      Session[]
  farms         Farm[]
  memberships   FarmMember[]
  reportsMade   Report[]     @relation("ReportCreatedBy")
  reportsAssigned Report[]   @relation("ReportAssignedTo")
}

/* A crop-disease report from the mobile app: a farmer photographs a sick crop,
   it drops a pin on the farm map, and a laborer (team member) is dispatched to
   treat it. open → assigned → resolved. */
model Report {
  id           String   @id @default(cuid())
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation("ReportCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("ReportAssignedTo", fields: [assignedToId], references: [id])
  lat          Float
  lng          Float
  crop         String?
  category     String   @default("other") // irrigation, fence, pest, disease, flooding, drainage, equipment, livestock, tree, access, other
  issue        String? // suspected disease / what's wrong
  severity     String   @default("medium") // low, medium, high
  note         String?
  photo        String? // data URL (base64) — swap for blob storage later
  status       String   @default("open") // open, assigned, resolved
  createdAt    DateTime @default(now())

  @@index([farmId])
  @@index([assignedToId])
}

/* A person on a farm's team. The owner is the farm's creator (Farm.userId);
   members are collaborators who can see and work the same farm. */
model FarmMember {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // manager, scout, member
  createdAt DateTime @default(now())

  @@unique([farmId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Farm {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  createdAt DateTime @default(now())
  fields    Field[]
  members   FarmMember[]
  reports   Report[]

  @@index([userId])
}

model Field {
  id         String        @id @default(cuid())
  farmId     String
  farm       Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name       String
  landType   String        @default("Field") // Field, Pasture, Orchard, Bed
  geometry   Json // GeoJSON Polygon: { type, coordinates:[[[lng,lat],...]] }
  areaAcres  Float         @default(0)
  centerLat  Float
  centerLng  Float
  createdAt  DateTime      @default(now())
  plantings  Planting[]
  scouts     Observation[]
  soil       SoilSample[]
  weeds      WeedPin[]

  @@index([farmId])
}

model Planting {
  id        String    @id @default(cuid())
  fieldId   String
  field     Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  crop      String
  variety   String?
  plantedOn DateTime?
  status    String    @default("growing") // growing, harvested, fallow
  createdAt DateTime  @default(now())

  @@index([fieldId])
}

model Observation {
  id           String   @id @default(cuid())
  fieldId      String
  field        Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  health       Int      @default(3) // 1 (poor) .. 5 (thriving)
  weedPressure String   @default("none") // none, low, medium, high
  note         String?
  photo        String? // data URL (base64) — swap for blob storage later
  createdAt    DateTime @default(now())

  @@index([fieldId])
}

/* A geotagged soil reading — the ground-truth the Wiggler will act on:
   where it's dry, acidic, or depleted, and where casting matters most. */
model SoilSample {
  id          String   @id @default(cuid())
  fieldId     String
  field       Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  lat         Float
  lng         Float
  moisture    Float? // volumetric water content %
  ph          Float? // 0–14
  temperature Float? // °C
  nitrogen    Float? // ppm
  phosphorus  Float? // ppm
  potassium   Float? // ppm
  note        String?
  createdAt   DateTime @default(now())

  @@index([fieldId])
}

/* A weed hotspot — where the Wiggler goes to work. Each pin is a target
   waypoint; density sets priority, status tracks whether it's been cleared
   (by hand today, by the worm tomorrow). */
model WeedPin {
  id        String   @id @default(cuid())
  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  density   String   @default("medium") // low, medium, high
  species   String?
  note      String?
  status    String   @default("active") // active, cleared
  createdAt DateTime @default(now())

  @@index([fieldId])
}
