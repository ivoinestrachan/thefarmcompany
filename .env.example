# Postgres connection for Prisma. Copy to .env for local dev, and add the same
# vars in Vercel → Settings → Environment Variables. Both .env files are gitignored.
#
# Easiest: Vercel → Storage → Create Database → Postgres (auto-adds the vars).
#   DATABASE_URL = the POOLED url  (Vercel: POSTGRES_PRISMA_URL,  Neon: ...-pooler...)
#   DIRECT_URL   = the DIRECT url  (Vercel: POSTGRES_URL_NON_POOLING, Neon: direct)
#
# Then run:  npx prisma db push     (creates the Signup table)
# View them: npx prisma studio      (opens a table browser)

DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
